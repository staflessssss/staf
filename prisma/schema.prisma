generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String?
  role           UserRole  @default(CLIENT)
  tenantId       String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model InviteToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  tenantId  String
  email     String
  role      UserRole @default(CLIENT)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model RateLimitBucket {
  key             String   @id
  count           Int
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

enum UserRole {
  ADMIN
  CLIENT
}

model Tenant {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  status                 TenantStatus            @default(ONBOARDING)
  timezone               String                  @default("UTC")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  users                  User[]
  inviteTokens           InviteToken[]
  channelConnections     ChannelConnection[]
  integrationConnections IntegrationConnection[]
  agents                 Agent[]
}

enum TenantStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  CHURNED
}

model ChannelConnection {
  id             String           @id @default(cuid())
  tenantId       String
  type           ChannelType
  status         ConnectionStatus @default(PENDING)
  credentialsEnc String
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  agents         Agent[]

  @@unique([tenantId, type])
}

model IntegrationConnection {
  id             String           @id @default(cuid())
  tenantId       String
  type           IntegrationType
  status         ConnectionStatus @default(PENDING)
  credentialsEnc String
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type])
}

enum ChannelType {
  GMAIL
  INSTAGRAM
  TELEGRAM
  WHATSAPP
}

enum IntegrationType {
  GOOGLE_SHEETS
  GOOGLE_CALENDAR
  GOOGLE_DRIVE
  HONEYBOOK
  HUBSPOT
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  REVOKED
}

model Agent {
  id            String            @id @default(cuid())
  tenantId      String
  channelId     String
  name          String
  persona       String
  tone          String            @default("friendly")
  languagePreference String?
  status        AgentStatus       @default(ACTIVE)
  channelConfig Json?
  n8nWorkflowId String?
  webhookSecret String?
  deployedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  channel       ChannelConnection @relation(fields: [channelId], references: [id])
  features      Feature[]
  conversations Conversation[]
  delayedDeliveries DelayedDelivery[]
  events          AgentEvent[]

  @@unique([channelId])
}

enum AgentStatus {
  DRAFT
  DEPLOYING
  ACTIVE
  PAUSED
  ERROR
}

model Feature {
  id               String      @id @default(cuid())
  agentId          String
  name             String
  description      String
  type             FeatureType
  sortOrder        Int         @default(0)
  knowledgeContent String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  agent            Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

enum FeatureType {
  KNOWLEDGE
}

model Conversation {
  id                 String             @id @default(cuid())
  agentId            String
  contactId          String
  contactUsername    String?
  contactDisplayName String?
  channel            ChannelType
  status             ConversationStatus @default(ACTIVE)
  manualOnly         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  agent              Agent              @relation(fields: [agentId], references: [id])
  delayedDeliveries DelayedDelivery[]
  messages           Message[]
  memory             ConversationMemory?
  agentMonitorThread AgentMonitorThread?
  executionTraces    ExecutionTrace[]
  events             AgentEvent[]

  @@unique([agentId, contactId])
}

model AgentMonitorThread {
  id                            String       @id @default(cuid())
  conversationId                String       @unique
  telegramChatId                String
  latestInboundMessageId        String
  latestInboundSourceMessageId  String?
  latestInboundAt               DateTime?
  responseAlertedAt             DateTime?
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt
  conversation             Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ConversationMemory {
  id             String       @id @default(cuid())
  conversationId String       @unique
  memory         Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ExecutionTrace {
  id             String       @id @default(cuid())
  conversationId String
  agentId        String
  channel        ChannelType
  inboundMessage String
  memoryBefore   Json?
  promptPreview  String?
  toolCalls      Json?
  toolResults    Json?
  modelRawText   String?
  finalMessage   String?
  attachments    Json?
  delivery       Json?
  memoryUpdate   Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([agentId, createdAt])
}

model AgentEvent {
  id             String           @id @default(cuid())
  agentId        String
  conversationId String?
  channel        ChannelType
  type           AgentEventType
  status         AgentEventStatus @default(SUCCEEDED)
  source         AgentEventSource @default(LIVE)
  dedupeKey      String?          @unique
  durationMs     Int?
  metadata       Json?
  occurredAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  agent          Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([agentId, occurredAt])
  @@index([conversationId, occurredAt])
  @@index([type, status, occurredAt])
}

enum AgentEventType {
  CONVERSATION_STARTED
  INBOUND_RECEIVED
  REPLY_SENT
  AVAILABILITY_CHECKED
  PRICING_GUIDE_SENT
  LEAD_QUALIFIED
  CONSULTATION_CHECKED
  CONSULTATION_BOOKED
  HANDOFF_REQUESTED
  HANDOFF_RESOLVED
  FOLLOW_UP_SENT
  DELIVERY_FAILED
}

enum AgentEventStatus {
  SUCCEEDED
  FAILED
  BLOCKED
}

enum AgentEventSource {
  LIVE
  TEST
  BACKFILL
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  toolName       String?
  toolInput      Json?
  toolResult     Json?
  durationMs     Int?
  model          String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ESCALATED
}

model DelayedDelivery {
  id             String                @id @default(cuid())
  agentId         String
  conversationId  String
  kind            DelayedDeliveryKind
  status          DelayedDeliveryStatus @default(PENDING)
  dueAt           DateTime
  payload         Json?
  attempts        Int                   @default(0)
  error           String?
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  canceledAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  agent           Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation    Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([conversationId, kind, status])
}

enum DelayedDeliveryKind {
  BUFFERED_REPLY
  FOLLOW_UP
  HANDOFF
}

enum DelayedDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  CANCELED
  FAILED
}
